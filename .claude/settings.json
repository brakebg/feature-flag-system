{
  "enabledPlugins": {
    "learning-output-style@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false
  },
  "env": {
    "ECC_GATEGUARD": "off"
  },
  "claudeMdExcludes": [
    "**/.claude/CLAUDE.md",
    "**/.claude/rules/**"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_locked_files.py\""
          }
        ]
      }
    ]
  }
}
